// Finite evaluation scenarios. No action launches a host job.
enum Phase { Waiting, Queued, Running, Failed, Complete, Cancelled, Returned }

system Producer {
  state sent: Bool = false
  state returned: Bool = false
  state reclaimed: Bool = false
  capability permit: Once<Unit>
  port output send: Once<Unit>
  port input takeback: Once<Unit>

  action output send {
    require sent == false
    emit permit
    consume permit
    set sent = true
  }
  action input takeback(permit: Once<Unit>) {
    require sent
    require returned == false
    set returned = true
  }
  action reclaim {
    require returned
    require reclaimed == false
    consume permit
    set reclaimed = true
  }
  observe sent, returned, reclaimed
}

system Worker {
  state phase: Phase = Phase.Waiting
  state retried: Bool = false
  state result: Bool = false
  state copied: Bool = false
  state monitored: Bool = false
  port input accept: Once<Unit>
  port output giveback: Once<Unit>

  action input accept(permit: Once<Unit>) {
    require phase == Phase.Waiting
    set phase = Phase.Queued
  }
  action start grade { work: 1 } {
    require phase == Phase.Queued
    set phase = Phase.Running
  }
  action fail {
    require phase == Phase.Running
    require retried == false
    set phase = Phase.Failed
  }
  action retry {
    require phase == Phase.Failed
    require retried == false
    set retried = true
    set phase = Phase.Queued
  }
  action finish {
    require phase == Phase.Running
    consume permit
    set phase = Phase.Complete
    set result = true
  }
  action cancel_queued {
    require phase == Phase.Queued
    consume permit
    set phase = Phase.Cancelled
  }
  action cancel_running {
    require phase == Phase.Running
    consume permit
    set phase = Phase.Cancelled
  }
  action cancel_failed {
    require phase == Phase.Failed
    consume permit
    set phase = Phase.Cancelled
  }
  action output giveback {
    require phase == Phase.Queued
    emit permit
    consume permit
    set phase = Phase.Returned
  }
  action monitor {
    require monitored == false
    set monitored = true
  }
  hide action monitor
  action cache {
    require phase == Phase.Complete
    require copied == false
    set copied = result
  }
  observe phase, retried, result, copied
}

compose Evaluation {
  connect Producer.send -> Worker.accept
  connect Worker.giveback -> Producer.takeback
}
