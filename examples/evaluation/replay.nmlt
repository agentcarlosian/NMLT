// Same two recorded candidates as the direct-library arm: one rejection, then
// the supplied proof. Actual proof authority comes from the pinned adapter.
fn check(alias: Text, proof: Text) -> Outcome<Text> {
  let handle = job_start_lean_project(alias, proof);
  job_collect(handle)
}

fn replay(alias: Text, proof: Text) -> Outcome<Text> {
  match check(alias, "True.intro") {
    Ok(receipt) => Ok(receipt),
    Err(message) => check(alias, proof)
  }
}
