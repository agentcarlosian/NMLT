{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmlt.dev/schemas/behavior-core-v1.schema.json",
  "title": "NMLT finite behavior core v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_path",
    "source_sha256",
    "enums",
    "systems",
    "compositions",
    "refinements"
  ],
  "properties": {
    "schema": { "const": "behavior-core-v1" },
    "source_path": { "type": "string", "minLength": 1 },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" },
        "uniqueItems": true
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/system" }
    },
    "compositions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/composition" }
    },
    "refinements": {
      "type": "array",
      "items": { "$ref": "#/$defs/refinement" }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "term": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "value"],
          "properties": {
            "kind": { "const": "bool" },
            "type": { "const": "Bool" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type"],
          "properties": {
            "kind": { "const": "unit" },
            "type": { "const": "Unit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "constructor"],
          "properties": {
            "kind": { "const": "enum" },
            "type": { "type": "string" },
            "constructor": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "field"],
          "properties": {
            "kind": { "const": "read" },
            "type": { "type": "string" },
            "field": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "value"],
          "properties": {
            "kind": { "const": "not" },
            "type": { "const": "Bool" },
            "value": { "$ref": "#/$defs/term" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type", "left", "right"],
          "properties": {
            "kind": { "const": "equal" },
            "type": { "const": "Bool" },
            "left": { "$ref": "#/$defs/term" },
            "right": { "$ref": "#/$defs/term" }
          }
        }
      ]
    },
    "resourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "consumes",
        "transfers",
        "receives",
        "grade",
        "relies",
        "guarantees"
      ],
      "properties": {
        "requires": { "$ref": "#/$defs/stringSet" },
        "consumes": { "$ref": "#/$defs/stringSet" },
        "transfers": { "$ref": "#/$defs/stringSet" },
        "receives": { "$ref": "#/$defs/stringSet" },
        "grade": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "relies": { "$ref": "#/$defs/stringSet" },
        "guarantees": { "$ref": "#/$defs/stringSet" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "hidden",
        "parameters",
        "guards",
        "guard_ast",
        "updates",
        "update_ast",
        "outputs",
        "resources"
      ],
      "properties": {
        "direction": { "enum": ["internal", "input", "output"] },
        "hidden": { "type": "boolean" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        },
        "guards": { "type": "array", "items": { "type": "string" } },
        "guard_ast": {
          "type": "array",
          "items": { "$ref": "#/$defs/term" }
        },
        "updates": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "update_ast": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/term" }
        },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "resources": { "$ref": "#/$defs/resourceProfile" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "capabilities", "ports", "actions", "observe"],
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "initial", "initial_ast"],
            "properties": {
              "type": { "type": "string" },
              "initial": { "type": "string" },
              "initial_ast": { "$ref": "#/$defs/term" }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "payload"],
            "properties": {
              "direction": { "enum": ["input", "output"] },
              "payload": { "type": "string" }
            }
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/action" }
        },
        "observe": { "type": "array", "items": { "type": "string" } }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_system",
        "left_action",
        "right_system",
        "right_action"
      ],
      "properties": {
        "left_system": { "type": "string" },
        "left_action": { "type": "string" },
        "right_system": { "type": "string" },
        "right_action": { "type": "string" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "connections"],
      "properties": {
        "left": { "type": "string" },
        "right": { "type": "string" },
        "connections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/connection" }
        }
      }
    },
    "refinement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concrete", "abstract", "state_map", "hidden_actions"],
      "properties": {
        "concrete": { "type": "string" },
        "abstract": { "type": "string" },
        "state_map": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "hidden_actions": { "$ref": "#/$defs/stringSet" }
      }
    }
  }
}
