{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmlt.dev/schemas/behavior-execution-v1.schema.json",
  "title": "NMLT untrusted finite execution witness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_sha256", "behavior", "states", "actions"],
  "properties": {
    "schema": {"const": "behavior-execution-v1"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "behavior": {"type": "string", "minLength": 1},
    "states": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right", "authority"],
      "properties": {
        "left": {"type": "integer", "minimum": 0},
        "right": {"type": "integer", "minimum": 0},
        "authority": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}
      }
    }},
    "actions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {"type": ["string", "null"]},
        "right": {"type": ["string", "null"]}
      },
      "anyOf": [
        {"properties": {"left": {"type": "string", "minLength": 1}}},
        {"properties": {"right": {"type": "string", "minLength": 1}}}
      ]
    }}
  }
}
